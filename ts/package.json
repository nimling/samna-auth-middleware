{
  "name": "@nimling/samna-auth-edge",
  "version": "0.0.0",
  "description": "Session auth edge client for samna_auth, mirroring the Go middleware's session validation surface only",
  "author": "nimling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimling/samna_auth_middleware.git",
    "directory": "ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
